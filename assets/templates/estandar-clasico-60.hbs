<html lang='es'>
  <head>
    <meta charset='UTF-8' />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      /*
        REGLA GENERAL para todo este archivo: nunca usar mm, cm, in,
        pt ni pc. Todas son unidades "físicas" en CSS y el navegador
        las convierte a px usando SIEMPRE el estándar fijo de 96dpi
        (1in=96px, 1pt=1/72in=1.333px), sin importar el dpi real que
        definiste en ETIQUETA_LABEL_CONFIG (360). Como el body/viewport
        ya están en px calculados a 360dpi, cualquier tamaño puesto en
        pt/mm queda ~3.75x más chico de lo esperado (360/96 = 3.75),
        que fue justo el bug de las fuentes "diminutas". Para agregar
        un campo nuevo: define su tamaño ya en px (si quieres partir
        de un valor en pt del diseño de Illustrator, multiplícalo por
        360/72 = 5 antes de ponerlo aquí).
      */

      /*
        FUENTE: solo se embebe Selawik (sustituto libre de Segoe UI,
        que es propietaria y no se puede redistribuir) cuando el
        backend NO corre en Windows -> ahí fontBase64 llega vacío
        desde el service y este bloque no se imprime en absoluto,
        dejando 'Segoe UI' real del sistema como antes (evita el bug
        de la "J" asimétrica que tenía Selawik). En Render (Linux)
        fontBase64 sí llega, y ahí sirve de sustituto porque Segoe UI
        no existe en ese sistema operativo.
      */
      {{#if fontBase64}}
      @font-face {
        font-family: 'Selawik';
        src: url('data:font/truetype;base64,{{{fontBase64}}}') format('truetype');
        font-weight: normal;
      }
      @font-face {
        font-family: 'Selawik';
        src: url('data:font/truetype;base64,{{{fontBoldBase64}}}') format('truetype');
        font-weight: bold;
      }
      {{/if}}

      body {
        /*
          IMPORTANTE: usar px, no mm.
          Chromium convierte "mm" en CSS usando el estándar fijo
          1mm = 96/25.4px (~3.78px), sin importar el deviceScaleFactor
          ni el viewport que le pasamos desde Puppeteer (que se calculó
          a 360dpi). Esto hacía que el <body> quedara mucho más chico
          que el viewport real, dejando toda la etiqueta
          "flotando" en una esquina y el fondo sin cubrir el resto:
          por eso se veía en blanco. Al usar los mismos px que
          ETIQUETA_LABEL_PX (que sí están calculados a 360dpi), el
          body ocupa exactamente el viewport y el fondo cubre todo.
        */
        width:{{widthPx}}px;
                                  height:{{heightPx}}px;
                                  font-family: {{#if fontBase64}}'Selawik', {{/if}}'Segoe UI', {{{fallbackFontFamily}}};
                                }

                                .etiqueta {
                                  position: relative;
                                  width: 100%;
                                  height: 100%;
                                  background-image: url('data:image/png;base64,{{{fondoBase64}}}');
                                  background-size: 100% 100%;
                                  background-repeat: no-repeat;
                                  overflow: hidden;
                                }

                                /* Todas las posiciones son % del tamaño de la etiqueta,
                                   así se mantienen proporcionales sin importar el DPI final.
                                   Son un primer cálculo a ojo sobre tu diseño de referencia —
                                   ajústalas si al imprimir no calzan pixel-perfect. */

                                /*
                                  Referencia (imagen 2): el nombre del producto va dentro de la
                                  franja celeste; las 3 filas de datos van debajo, en dos
                                  columnas; el teléfono/correo y el sello "APROBADO" YA vienen
                                  en el fondo (etiqueta-fondo.png), así que no se dibujan aquí.
                                  Estos valores son un punto de partida cercano al diseño real;
                                  ajústalos comparando con una captura una vez que el fondo ya
                                  se vea (con el fix de px de arriba).
                                */

                                /*
                                  Medido con análisis de imagen sobre el diseño de referencia
                                  (no a ojo): la franja celeste ocupa ~27%-45% de la altura,
                                  y el texto del producto va DENTRO de ella, alineado a la
                                  IZQUIERDA (no a la derecha), centrado en el rango 34%-40%.
                                */
                                .campo-producto {
                                  position: absolute;
                                  top: 27.3%;
                                  height: 17.9%;
                                  left: 27%;
                                  right: 6%;
                                  display: flex;
                                  align-items: center;
                                  justify-content: center;
                                  text-align: center;
                                  color: #1a1a1a;
                                  font-size: 58px;      /* antes 48px (300dpi) — x1.2 por el cambio a 360dpi */
                                  line-height: 1.05;    /* para que 2 líneas quepan cómodas en la franja */
                                  font-weight: 700;
                                  text-transform: uppercase;
                                  white-space: normal;  /* permite que nombres largos bajen a 2 líneas */
                                }

                                #medidor-producto {
                    position: absolute;
                    visibility: hidden;
                    left: -9999px;
                    top: 0;
                    text-align: center;
                    text-transform: uppercase;
                    font-weight: 700;
                    line-height: 1.05;
                  }
                          /*
                            GRID DE 2 COLUMNAS FIJO: columna 1 va de 6% a 47%
                            (ancho ~41%), columna 2 va de 48% a 94% (ancho ~46%),
                            con un margen de 1% entre ambas. Este layout es SIEMPRE
                            igual sin importar el contenido — ya no depende de JS
                            para calcular su posición, así las 3 filas (LOTE/
                            FABRICANTE, PESO NETO/PESO BRUTO, FECHA FAB/FECHA VENC)
                            quedan perfectamente alineadas entre sí siempre.
                            Si el texto no entra en su columna, en vez de truncarlo
                            o desalinear el layout, se reduce su font-size
                            automáticamente (ver ajustarFuenteCampo() más abajo).
                          */
                          .campo-lote {
                            position: absolute;
                            top: 50%;
                            left: 6%;
                            right: 53%;
                            font-size: 50px;  /* antes 42px (300dpi) — x1.2 por el cambio a 360dpi */
                            font-weight: 700;
                            color: #111;
                            white-space: nowrap;
                            overflow: hidden;
                          }

                          .campo-fabricante {
                            position: absolute;
                            top: 50%;
                            left: 48%;
                            right: 6%;
                            font-size: 50px;  /* antes 42px (300dpi) — x1.2 por el cambio a 360dpi */
                            font-weight: 700;
                            color: #111;
                            white-space: nowrap;
                            overflow: hidden;
                          }

                                .campo-peso-neto {
                                  position: absolute;
                                  top: 61%;
                                  left: 6%;
                                  right: 53%;
                                  font-size: 50px;  /* antes 42px (300dpi) — x1.2 por el cambio a 360dpi */
                                  font-weight: 700;
                                  color: #111;
                                  white-space: nowrap;
                                  overflow: hidden;
                                }

                                  .campo-peso-bruto {
                            position: absolute;
                            top: 61%;
                            left: 48%;
                            right: 6%;
                            font-size: 50px;  /* antes 42px (300dpi) — x1.2 por el cambio a 360dpi */
                            font-weight: 700;
                            color: #111;
                            white-space: nowrap;
                            overflow: hidden;
                          }
                                .campo-fecha-fab {
                                  position: absolute;
                                  top: 72%;
                                  left: 6%;
                                  right: 53%;
                                  font-size: 50px;  /* antes 42px (300dpi) — x1.2 por el cambio a 360dpi */
                                  font-weight: 700;
                                  color: #111;
                                  white-space: nowrap;
                                  overflow: hidden;
                                }

                                .campo-fecha-venc {
                            position: absolute;
                            top: 72%;
                            left: 48%;
                            right: 6%;
                            font-size: 50px;  /* antes 42px (300dpi) — x1.2 por el cambio a 360dpi */
                            font-weight: 700;
                            color: #111;
                            white-space: nowrap;
                            overflow: hidden;
                          }

                                /*
                                  Proforma: abajo, cerca del sello "APROBADO" (fijo en el
                                  fondo), alineado a la derecha en la misma columna.
                                */
                                .campo-proforma {
                                  position: absolute;
                                  /*
                                    El sello "APROBADO" (fijo en la imagen de fondo) está
                                    centrado horizontalmente en ~75% del ancho de la etiqueta
                                    (medido con análisis de píxeles: bbox x 656-897 sobre un
                                    ancho de etiqueta de 922px → centro en 75.1%). Antes
                                    proforma iba alineada a la derecha (right:6%); ahora se
                                    centra en esa misma coordenada, en columna debajo del sello.
                                  */
                                  top: 88%;
                                  left: 75%;
                                  transform: translateX(-50%);
                                  text-align: center;
                                  font-size: 40px;  /* antes 33px (300dpi) — x1.2 por el cambio a 360dpi */
                                  font-weight: 700;
                                  color: #1a1a1a;
                                }

                                .campo span.label {
                                  font-weight: 800;
                                }
    </style>
  </head>
  <body>
    <div class='etiqueta'>
      <div class='campo-producto' id='campo-producto'><span
          id='nombre-producto'
        >{{producto}}</span></div>
      <div id='medidor-producto'></div>
      <div class='campo-lote'><span class='label'>LOTE:</span>
        <span class='valor' id='valor-lote'>{{numeroLote}}</span></div>
      <div class='campo-fabricante'><span class='label'>FABRICANTE:</span>
        <span class='valor' id='valor-fabricante'>{{fabricante}}</span></div>

      <div class='campo-peso-neto'><span class='label'>{{labelNeto}}:</span>
        {{pesoNeto}}
        {{unidadNeto}}</div>
      <div class='campo-peso-bruto'><span class='label'>PESO BRUTO:</span>
        {{pesoBruto}}
        {{unidadBruto}}</div>

      <div class='campo-fecha-fab'><span class='label'>FECHA FAB:</span>
        {{fechaFabricacion}}</div>
      <div class='campo-fecha-venc'><span class='label'>FECHA VENC:</span>
        {{fechaVencimiento}}</div>

      {{#if hayProforma}}<div class='campo-proforma'>{{proforma}}</div>{{/if}}
    </div>

    <script>
      /*
        Auto-ajuste de fuente SIN truncar: cada fila (LOTE, FABRICANTE,
        PESO NETO, PESO BRUTO, FECHA FAB, FECHA VENC) vive en una columna
        de ancho FIJO por CSS (definido en % — ver .campo-lote, .campo-fabricante,
        etc). Si el texto no entra en ese ancho a la fuente máxima, se reduce
        el font-size del propio elemento paso a paso hasta que quepa entero
        en una sola línea (scrollWidth <= clientWidth). Nunca se corta texto
        y el layout de 2 columnas nunca se mueve, sin importar qué tan largo
        sea un LOTE o un FABRICANTE.
      */
      function ajustarFuenteCampo(el, fuenteMax, fuenteMin, paso) {
        if (!el) return;
        var fontSize = fuenteMax;
        el.style.fontSize = fontSize + 'px';
        while (el.scrollWidth > el.clientWidth && fontSize > fuenteMin) {
          fontSize -= paso;
          el.style.fontSize = fontSize + 'px';
        }
      }
      function ajustarFilasDatos() {
        var FUENTE_MAX = 50, FUENTE_MIN = 22, PASO = 2;
        [
          '.campo-lote',
          '.campo-fabricante',
          '.campo-peso-neto',
          '.campo-peso-bruto',
          '.campo-fecha-fab',
          '.campo-fecha-venc'
        ].forEach(function (selector) {
          ajustarFuenteCampo(document.querySelector(selector), FUENTE_MAX, FUENTE_MIN, PASO);
        });
      }
      window.ajustarNombreProducto = function () { var box =
      document.getElementById('campo-producto'); var texto =
      document.getElementById('nombre-producto').textContent; var medidor =
      document.getElementById('medidor-producto'); if (!box || !medidor) return;
      var FUENTE_MAX = 58, FUENTE_MIN = 26, PASO = 2; var boxWidth =
      box.clientWidth, boxHeight = box.clientHeight; medidor.style.width =
      boxWidth + 'px'; medidor.textContent = texto; var fontSize = FUENTE_MAX;
      medidor.style.fontSize = fontSize + 'px'; while (medidor.scrollHeight >
      boxHeight && fontSize > FUENTE_MIN) { fontSize -= PASO;
      medidor.style.fontSize = fontSize + 'px'; } box.style.fontSize = fontSize
      + 'px'; };
      window.ajustarNombreProducto();
      ajustarFilasDatos();
    </script>
  </body>
</html>