<html lang='es'>
  <head>
    <meta charset='UTF-8' />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      /* Con rombo 10x6 (10,8 x 6 cm, 1531x851 px a 360 dpi). HTML/CSS puro, solo px. Margenes de seguridad: la impresora corta el borde superior y el derecho. */
      body {
        width: {{widthPx}}px;
        height: {{heightPx}}px;
        font-family: 'Segoe UI', {{{fallbackFontFamily}}};
        font-weight: 700;
        color: #111;
        background: #fff;
        overflow: hidden;
      }
      .etiqueta { position: relative; width: 100%; height: 100%; overflow: hidden; background: #fff; }
      .marco { position: absolute; left: 64px; top: 36px; right: 60px; bottom: 28px; border: 6px solid #1B2B5B; border-radius: 16px; }
      .esc { position: absolute; left: 0; top: 0; width: 100%; height: 100%; transform: scale(0.96); transform-origin: 64px 36px; }
      .a { position: absolute; }
      .k { font-size: 28px; font-weight: 700; color: #1B2B5B; white-space: nowrap; letter-spacing: 0.5px; }
      .v { margin-top: 6px; height: 92px; overflow: hidden; font-size: 42px; line-height: 1.1; font-weight: 700; color: #111; }
      .titulo { display: flex; align-items: center; overflow: hidden; line-height: 1.05; font-weight: 700; text-transform: uppercase; color: #111; }
      .ct { display: flex; align-items: center; gap: 18px; white-space: nowrap; overflow: hidden; font-weight: 600; color: #111; }
      .ct svg { flex: none; color: #1B2B5B; width: 1.1em; height: 1.1em; }
      .apr { color: #2E7D32; font-weight: 800; white-space: nowrap; text-align: center; }
      .check { display: block; }
      .qr img { width: 100%; height: 100%; display: block; }
      .cap { font-size: 26px; font-weight: 400; color: #555; text-align: center; white-space: nowrap; }
      .rombo text { font-family: 'Segoe UI', Arial, sans-serif; font-weight: 700; font-size: 46px; text-anchor: middle; dominant-baseline: central; }
      .lg { display: block; }
    </style>
  </head>
  <body>
    <div class='etiqueta'>
    <div class='esc'>
      <div class='marco'></div>
      <img class='a lg' style='left:114px; top:76px; width:290px' src='data:image/png;base64,{{{logoBase64}}}' />
      <div class='a k' style='left:464px; top:76px; font-size:30px'>PRODUCTO</div>
      <div class='a titulo' id='producto' style='left:464px; top:118px; width:700px; height:130px; font-size:84px'>{{producto}}</div>
      <svg class='a rombo' style='left:1214px; top:62px; width:230px; height:230px' viewBox='0 0 200 200'>
        <polygon points='100,4 148,52 100,100 52,52' fill='#D62828' stroke='#111' stroke-width='3'/>
        <polygon points='52,52 100,100 52,148 4,100' fill='#1E6FD9' stroke='#111' stroke-width='3'/>
        <polygon points='148,52 196,100 148,148 100,100' fill='#F5B800' stroke='#111' stroke-width='3'/>
        <polygon points='100,100 148,148 100,196 52,148' fill='#fff' stroke='#111' stroke-width='3'/>
        <text x='100' y='54' fill='#fff'>{{nfpaInflamabilidad}}</text>
        <text x='54' y='102' fill='#fff'>{{nfpaSalud}}</text>
        <text x='146' y='102' fill='#111'>{{nfpaReactividad}}</text>
      </svg>
      <div class='a' style='left:100px; right:96px; top:300px; height:4px; background:#F4610B'></div>
      <div class='a' style='left:114px; top:322px; width:320px'><div class='k'>FABRICANTE</div><div class='v'>{{fabricante}}</div></div>
      <div class='a' style='left:454px; top:322px; width:320px'><div class='k'>LOTE</div><div class='v'>{{numeroLote}}</div></div>
      <div class='a' style='left:794px; top:322px; width:320px'><div class='k'>N° PROFORMA</div><div class='v'>{{proforma}}</div></div>
      <div class='a' style='left:1134px; top:322px; width:320px'><div class='k'>PESO BRUTO</div><div class='v'>{{pesoBruto}} {{unidadBrutoLabel}}</div></div>
      <div class='a' style='left:114px; top:470px; width:320px'><div class='k'>F. FABRICACIÓN</div><div class='v'>{{fechaFabricacion}}</div></div>
      <div class='a' style='left:454px; top:470px; width:320px'><div class='k'>F. VENCIMIENTO</div><div class='v'>{{fechaVencimiento}}</div></div>
      <div class='a' style='left:794px; top:470px; width:320px'><div class='k'>TARA</div><div class='v'>{{tara}} {{unidadBrutoLabel}}</div></div>
      <div class='a' style='left:1134px; top:470px; width:320px'><div class='k'>{{labelNeto}}</div><div class='v'>{{pesoNeto}} {{unidadNetoLabel}}</div></div>
      <div class='a' style='left:100px; right:96px; top:612px; height:3px; background:#C9CDD6'></div>
      <div class='a ct' style='left:114px; top:660px; width:520px; height:48px; font-size:34px'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z'/></svg><span>943 598 055</span></div>
      <div class='a ct' style='left:114px; top:718px; width:620px; height:48px; font-size:34px'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect width='20' height='16' x='2' y='4' rx='2'/><path d='m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7'/></svg><span>ventas@excellencechemical.com</span></div>
      <div class='a' style='left:694px; top:672px; display:flex; align-items:center; gap:20px'><svg class='check' style='width:78px;height:78px' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50' fill='#2E7D32'/><polyline points='27,52 43,68 73,34' fill='none' stroke='#fff' stroke-width='9' stroke-linecap='round' stroke-linejoin='round'/></svg><span class='apr' style='font-size:44px'>APROBADO</span></div>
      <div class='a qr' style='left:1284px; top:628px; width:160px; height:160px'>{{#if coaValidado}}{{#if qrDataUrl}}<img src='{{{qrDataUrl}}}' />{{/if}}{{/if}}</div>
    </div>
    </div>

    <script>
      /* Auto-ajuste sin truncar: baja el font-size hasta que el texto entre en su caja. */
      function ajustar(el, max, min, paso, soloAncho) {
        if (!el) return;
        var fs = max;
        el.style.fontSize = fs + 'px';
        while ((el.scrollWidth > el.clientWidth + 1 || (!soloAncho && el.scrollHeight > el.clientHeight + 1)) && fs > min) {
          fs -= paso;
          el.style.fontSize = fs + 'px';
        }
      }
      window.ajustarNombreProducto = function () {
        ajustar(document.getElementById('producto'), 84, 36, 2);
        document.querySelectorAll('.v').forEach(function (el) { ajustar(el, 42, 24, 2); });
        document.querySelectorAll('.ct').forEach(function (el) { ajustar(el, 34, 22, 1, true); });
      };
      window.ajustarNombreProducto();
    </script>
  </body>
</html>
