<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  {{#if fontBase64}}
  @font-face {
    font-family: 'Selawik';
    src: url('data:font/truetype;base64,{{{fontBase64}}}') format('truetype');
    font-weight: normal;
  }
  @font-face {
    font-family: 'Selawik';
    src: url('data:font/truetype;base64,{{{fontBoldBase64}}}') format('truetype');
    font-weight: bold;
  }
  {{/if}}

  body {
    width: {{widthPx}}px;
    height: {{heightPx}}px;
    font-family: {{#if fontBase64}}'Selawik', {{/if}}'Segoe UI', {{{fallbackFontFamily}}};
  }

  .etiqueta {
    position: relative;
    width: 100%;
    height: 100%;
    background-image: url('data:image/png;base64,{{{fondoBase64}}}');
    background-size: 100% 100%;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  .campo-producto {
    position: absolute;
    top: 27.3%;
    height: 17.9%;
    left: 6%;
    right: 6%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #1a1a1a;
    font-size: 58px;
    line-height: 1.05;
    font-weight: 700;
    text-transform: uppercase;
    white-space: normal;
  }

  /*
    GRID DE 2 COLUMNAS FIJO: columna 1 va de 6% a 47% (ancho ~41%),
    columna 2 va de 48% a 94% (ancho ~46%), con 1% de margen entre
    ambas. Layout SIEMPRE igual sin importar el contenido — ya no
    depende de JS para calcular su posición, así LOTE/FABRICANTE,
    PESO NETO/PESO BRUTO y FECHA FAB/FECHA VENC quedan perfectamente
    alineados entre sí siempre. Si el texto no entra en su columna,
    en vez de truncarlo o desalinear el layout, se reduce su
    font-size automáticamente (ver ajustarFuenteCampo() más abajo).
  */
  .campo-lote {
    position: absolute;
    top: 50%;
    left: 6%;
    right: 53%;
    font-size: 50px;
    font-weight: 700;
    color: #111;
    white-space: nowrap;
    overflow: hidden;
  }

  .campo-fabricante {
    position: absolute;
    top: 50%;
    left: 48%;
    right: 6%;
    font-size: 50px;
    font-weight: 700;
    color: #111;
    white-space: nowrap;
    overflow: hidden;
  }

  .campo-peso-neto {
    position: absolute;
    top: 61%;
    left: 6%;
    right: 53%;
    font-size: 50px;
    font-weight: 700;
    color: #111;
    white-space: nowrap;
    overflow: hidden;
  }

  .campo-peso-bruto {
    position: absolute;
    top: 61%;
    left: 48%;
    right: 6%;
    font-size: 50px;
    font-weight: 700;
    color: #111;
    white-space: nowrap;
    overflow: hidden;
  }

  .campo-fecha-fab {
    position: absolute;
    top: 72%;
    left: 6%;
    right: 53%;
    font-size: 50px;
    font-weight: 700;
    color: #111;
    white-space: nowrap;
    overflow: hidden;
  }

  .campo-fecha-venc {
    position: absolute;
    top: 72%;
    left: 48%;
    right: 6%;
    font-size: 50px;
    font-weight: 700;
    color: #111;
    white-space: nowrap;
    overflow: hidden;
  }
  .campo-proforma {
    position: absolute;
    top: 88%;
    left: 75%;
    transform: translateX(-50%);
    text-align: center;
    font-size: 40px;
    font-weight: 700;
    color: #1a1a1a;
  }

  .campo span.label {
    font-weight: 800;
  }
</style>
</head>
<body>
  <div class="etiqueta">
    <div class="campo-producto">{{producto}}</div>

    <div class="campo-lote"><span class="label">LOTE:</span> <span class="valor" id="valor-lote">{{numeroLote}}</span></div>
    <div class="campo-fabricante"><span class="label">FABRICANTE:</span> <span class="valor" id="valor-fabricante">{{fabricante}}</span></div>

    <div class="campo-peso-neto"><span class="label">{{labelNeto}}:</span> {{pesoNeto}} {{unidadNeto}}</div>
    <div class="campo-peso-bruto"><span class="label">PESO BRUTO:</span> {{pesoBruto}} {{unidadBruto}}</div>

    <div class="campo-fecha-fab"><span class="label">FECHA FAB:</span> {{fechaFabricacion}}</div>
    <div class="campo-fecha-venc"><span class="label">FECHA VENC:</span> {{fechaVencimiento}}</div>

    {{#if hayProforma}}<div class="campo-proforma">{{proforma}}</div>{{/if}}
  </div>
</body>
  <script>
  /*
    Auto-ajuste de fuente SIN truncar: cada fila (LOTE, FABRICANTE,
    PESO NETO, PESO BRUTO, FECHA FAB, FECHA VENC) vive en una columna
    de ancho FIJO por CSS (ver .campo-lote, .campo-fabricante, etc).
    Si el texto no entra en ese ancho a la fuente máxima, se reduce
    el font-size del propio elemento paso a paso hasta que quepa
    entero en una sola línea (scrollWidth <= clientWidth). Nunca se
    corta texto y el layout de 2 columnas nunca se mueve, sin
    importar qué tan largo sea un LOTE o un FABRICANTE.
  */
  function ajustarFuenteCampo(el, fuenteMax, fuenteMin, paso) {
    if (!el) return;
    var fontSize = fuenteMax;
    el.style.fontSize = fontSize + 'px';
    while (el.scrollWidth > el.clientWidth && fontSize > fuenteMin) {
      fontSize -= paso;
      el.style.fontSize = fontSize + 'px';
    }
  }
  function ajustarFilasDatos() {
    var FUENTE_MAX = 50, FUENTE_MIN = 22, PASO = 2;
    [
      '.campo-lote',
      '.campo-fabricante',
      '.campo-peso-neto',
      '.campo-peso-bruto',
      '.campo-fecha-fab',
      '.campo-fecha-venc'
    ].forEach(function (selector) {
      ajustarFuenteCampo(document.querySelector(selector), FUENTE_MAX, FUENTE_MIN, PASO);
    });
  }

  ajustarFilasDatos();
  </script>
</html>